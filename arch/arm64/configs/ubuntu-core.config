# Ubuntu Core 24 requirements, applied after the board config:
#   make imx8_var_defconfig ffcp-ao.config ubuntu-core.config
#
# imx8_var_defconfig already provides squashfs (xz/lzo), loop, seccomp,
# cgroups/BPF, devtmpfs, autofs, user namespaces and the initrd
# decompressors; only what is missing or needs changing is listed here.

# snapd confinement: AppArmor must be in the active LSM list, not just built
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,apparmor,bpf"

# snaps and the base/kernel/gadget squashfs images
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y

# also checked by the snapcraft kernel plugin
CONFIG_SYN_COOKIES=y
CONFIG_ENCRYPTED_KEYS=y
